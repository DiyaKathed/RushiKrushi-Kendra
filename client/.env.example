# ==============================================================================
# Rushi Krushi Seva Kendra - Frontend Environment Variables (.env)
# ==============================================================================
# Copy this file to `client/.env` and replace the placeholder values with your
# credentials from the Supabase Dashboard (https://supabase.com/dashboard).
#
# Vite requires public variables to be prefixed with `VITE_`.
#
# IMPORTANT SECURITY NOTICE:
# - ONLY use the PUBLIC 'anon' key (Publishable API key) in this file.
# - NEVER put your 'service_role' secret key, database password, or secret tokens here.
# - Anything with a VITE_ prefix is bundled into the frontend and visible in the browser.
# ==============================================================================

# Your Supabase Project URL (e.g., https://xyzcompanyproject.supabase.co)
# Location in Supabase: Project Settings -> Configuration -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon Key (Public / Publishable API key)
# Location in Supabase: Project Settings -> Configuration -> API -> Project API Keys -> anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Backend Express API URL
# - In local development: leave blank (Vite local dev proxy automatically forwards /api to http://localhost:5050)
# - In production on Vercel: set to your deployed backend URL on Render (e.g., https://rushikrushi-server.onrender.com)
VITE_API_BASE_URL=
