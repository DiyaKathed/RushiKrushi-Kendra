# ==============================================================================
# Rushi Krushi Seva Kendra - Backend Environment Template (.env)
# ==============================================================================
# Copy this file to `server/.env` and configure for your local or production environment.
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit `server/.env` or any real secrets to Git.
# - Production deployments REQUIRE:
#     1) A persistent `MONGODB_URI` (in-memory MongoDB will refuse to boot in production)
#     2) A unique, cryptographically strong `JWT_SECRET` (at least 32 characters)
#     3) The correct `CLIENT_URL` corresponding to your production frontend domain
# ==============================================================================

# Server Network Configuration
PORT=5050
NODE_ENV=development

# Allowed Frontend URL for CORS (e.g., http://localhost:5180 for dev, or https://yourdomain.com in production)
CLIENT_URL=http://localhost:5180

# MongoDB Database Connection String
# - In development/testing: leave blank to automatically start embedded in-memory MongoDB.
# - In production: REQUIRED. Example for MongoDB Atlas:
#   mongodb+srv://<username>:<password>@cluster0.mongodb.net/rushikrushi?retryWrites=true&w=majority
MONGODB_URI=

# Session Authentication Secret
# - In development: replace with a custom local key or leave blank for development testing.
# - In production: REQUIRED. Generate a strong random 64-character secret.
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Administrator Initial Setup Password (Optional)
# - Used by `npm run admin:provision` or initial startup to provision `rushikrushi99@gmail.com`.
# - Leave blank to automatically generate a secure random password with a setup reset code.
ADMIN_INITIAL_PASSWORD=

# Optional Cloudinary Configuration for Image Uploads
# - If left blank, images are stored locally in `server/uploads/` during local development.
# - For production hosting with ephemeral containers, configure durable cloud storage:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
